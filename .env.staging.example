# =============================================================
# TALENTRA.ID Staging Environment Configuration Template
# Use this template for staging and pre-production deployments.
# IMPORTANT: All placeholder values marked <GENERATE_*> MUST be
# generated using a cryptographically secure random generator.
# =============================================================

# Application Runtime
APP_ENV=production
NEXT_PUBLIC_APP_ENV=staging
PORT=3000
API_BASE_URL=https://staging-api.talentra.id
PUBLIC_APP_URL=https://staging.talentra.id

# Authentication & JWT Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<GENERATE_64_CHAR_HEX_SECRET>
JWT_ALGORITHM=HS256
JWT_ISSUER=talentra.id
JWT_AUDIENCE=talentra.id
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookie Security (Enforced in production/staging)
COOKIE_NAME=talentra_session
REFRESH_COOKIE_NAME=talentra_refresh
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# CSRF Protection
CSRF_COOKIE_NAME=talentra_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# Identifier Lookup Privacy & Verification Peppers
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
IDENTIFIER_LOOKUP_PEPPER=<GENERATE_64_CHAR_HEX_PEPPER>
CV_VERIFICATION_TOKEN_PEPPER=<GENERATE_64_CHAR_HEX_PEPPER>

# Relational Database (Managed PostgreSQL / RDS)
# Example: postgresql+asyncpg://talentra_user:<STRONG_PASSWORD>@postgres.internal:5432/talentra_staging
DATABASE_URL=postgresql+asyncpg://talentra_staging_user:<DB_PASSWORD>@postgres.staging.internal:5432/talentra_staging_db

# Document Database (MongoDB Replica Set / Atlas)
# Example: mongodb://mongo1.internal:27017,mongo2.internal:27017/?replicaSet=rs0
MONGODB_URL=mongodb://mongo_staging_user:<MONGO_PASSWORD>@mongo.staging.internal:27017/talentra_staging_docs?authSource=admin
MONGODB_DATABASE=talentra_staging_docs

# Object Storage (AWS S3 / Wasabi / MinIO Cluster)
OBJECT_STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com
S3_REGION=ap-southeast-1
S3_BUCKET=talentra-staging-evidence-ap-southeast-1
S3_ACCESS_KEY_ID=<STAGING_S3_ACCESS_KEY>
S3_SECRET_ACCESS_KEY=<STAGING_S3_SECRET_KEY>
PRESIGNED_URL_TTL=900

# Demo Authentication (STRICTLY FORBIDDEN IN STAGING / PROD)
ENABLE_DEMO_AUTH=false
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# CORS (Strict origin list, NO wildcards)
ALLOWED_ORIGINS=https://staging.talentra.id,https://staging-app.talentra.id
