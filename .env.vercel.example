# TALENTRA.ID — Authoritative Vercel Free-Tier Environment Configuration Template
# Copy or set these environment variables in your Vercel Project Settings

# -------------------------------------------------------------
# APPLICATION RUNTIME
# -------------------------------------------------------------
APP_ENV=production
NODE_ENV=production

# -------------------------------------------------------------
# DATABASE (NEON POSTGRESQL)
# -------------------------------------------------------------
# Neon Pooled connection string with asyncpg driver prefix:
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-cool-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
REPOSITORY_BACKEND=postgres

# Serverless Connection Pooling (Neon PgBouncer primary)
# DB_POOL_CLASS=queue  # options: queue (conservative pool_size=2), nullpool (connection on-demand)
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=0

# -------------------------------------------------------------
# FILE STORAGE (VERCEL BLOB — PRIVATE)
# -------------------------------------------------------------
OBJECT_STORAGE_PROVIDER=vercel_blob
# Dedicated HMAC secret for FastAPI <-> trusted Next.js Blob broker communication (>= 32 random bytes)
# Strictly separate from JWT_SECRET_KEY:
BLOB_BROKER_HMAC_SECRET=generate-at-least-32-character-random-hex-broker-secret
BLOB_BROKER_TOKEN_TTL_SECONDS=60
BLOB_DOWNLOAD_URL_TTL_SECONDS=300

# In Vercel production: Vercel Blob OIDC (VERCEL_OIDC_TOKEN) is preferred and automatically injected by Vercel.
# For local development or manual fallback, BLOB_READ_WRITE_TOKEN is optional:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# -------------------------------------------------------------
# FREE-TIER STORAGE PROTECTION
# -------------------------------------------------------------
FREE_TIER_MODE=true
# 200 MB soft limit to safely protect free-tier limits (in bytes)
STORAGE_SOFT_LIMIT_BYTES=209715200

# -------------------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS
# -------------------------------------------------------------
# Minimum 32-byte high-entropy secret string
JWT_SECRET_KEY=generate-at-least-32-character-random-hex-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=talentra.id
JWT_AUDIENCE=talentra.id

# Salt/pepper for HMAC identifier lookup hashes (protects NISN / NIP / NUPTK privacy)
IDENTIFIER_LOOKUP_PEPPER=generate-a-unique-32-byte-secret-lookup-pepper

# Salt/pepper for CV public QR verification tokens
CV_VERIFICATION_TOKEN_PEPPER=generate-a-unique-32-byte-secret-cv-token-pepper

# Cookie Configuration (Vercel uses HTTPS)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ENABLE_DEMO_AUTH=false
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# -------------------------------------------------------------
# PUBLIC APP URL & CORS
# -------------------------------------------------------------
# Set to your authoritative Vercel deployment URL (without trailing slash)
PUBLIC_APP_URL=https://talentra.vercel.app
ALLOWED_ORIGINS=https://talentra.vercel.app
