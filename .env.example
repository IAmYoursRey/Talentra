# TALENTRA.ID Environment Configuration Template
# Copy this file to .env.local (for frontend) and .env (for backend)

# -------------------------------------------------------------
# APPLICATION RUNTIME
# -------------------------------------------------------------
# Options: development | test | production
# NOTE: Production mode enforces strict secret validation, Secure cookies,
# and permanently disables in-memory repositories and demo authentication.
APP_ENV=development

# -------------------------------------------------------------
# FRONTEND / BFF CONFIGURATION
# -------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_ENV=development
API_BASE_URL=http://127.0.0.1:8000

# -------------------------------------------------------------
# AUTHENTICATION & JWT SECURITY
# -------------------------------------------------------------
# Minimum 32-byte high-entropy secret key. NEVER use default in production!
JWT_SECRET_KEY=talentra-dev-secret-key-32-bytes-minimum-length-req
JWT_ALGORITHM=HS256
JWT_ISSUER=talentra.id
JWT_AUDIENCE=talentra.id
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# -------------------------------------------------------------
# COOKIE CONFIGURATION
# -------------------------------------------------------------
COOKIE_NAME=talentra_session
REFRESH_COOKIE_NAME=talentra_refresh
# Automatically True in production; can be False on localhost development without HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# -------------------------------------------------------------
# CSRF PROTECTION
# -------------------------------------------------------------
CSRF_COOKIE_NAME=talentra_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# -------------------------------------------------------------
# IDENTIFIER LOOKUP PRIVACY
# -------------------------------------------------------------
# Salt/pepper for HMAC identifier lookup hashes (preserves privacy of NISN/NIP)
IDENTIFIER_LOOKUP_PEPPER=talentra-identifier-lookup-pepper-v1

# -------------------------------------------------------------
# RELATIONAL DATABASE (POSTGRESQL)
# -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://talentra_dev:talentra_dev_secret@localhost:5432/talentra_db

# -------------------------------------------------------------
# DOCUMENT DATABASE (MONGODB)
# -------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=talentra_docs

# -------------------------------------------------------------
# OBJECT STORAGE (S3 / LOCAL)
# -------------------------------------------------------------
# Options: local | s3
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=backend/storage_data
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=talentra-evidence
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
PRESIGNED_URL_TTL=900

# -------------------------------------------------------------
# DEMO ACCESS (DEVELOPMENT ONLY)
# -------------------------------------------------------------
# Must be false in production environments. Production startup fails if enabled.
ENABLE_DEMO_AUTH=true
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true

# -------------------------------------------------------------
# CORS
# -------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
