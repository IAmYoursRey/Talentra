# TALENTRA.ID Environment Configuration Template
# For Local Development: Copy this file to .env.local (frontend) and backend/.env (backend)
# For Vercel Production: See .env.vercel.example

# -------------------------------------------------------------
# APPLICATION RUNTIME
# -------------------------------------------------------------
# Options: development | test | production
APP_ENV=development

# -------------------------------------------------------------
# FRONTEND / BFF CONFIGURATION
# -------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_ENV=development
API_BASE_URL=http://127.0.0.1:8000

# -------------------------------------------------------------
# AUTHENTICATION & JWT SECURITY
# -------------------------------------------------------------
JWT_SECRET_KEY=talentra-dev-secret-key-32-bytes-minimum-length-req
JWT_ALGORITHM=HS256
JWT_ISSUER=talentra.id
JWT_AUDIENCE=talentra.id
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# -------------------------------------------------------------
# COOKIE CONFIGURATION
# -------------------------------------------------------------
COOKIE_NAME=talentra_session
REFRESH_COOKIE_NAME=talentra_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# -------------------------------------------------------------
# CSRF PROTECTION
# -------------------------------------------------------------
CSRF_COOKIE_NAME=talentra_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# -------------------------------------------------------------
# IDENTIFIER LOOKUP PRIVACY
# -------------------------------------------------------------
# Salt/pepper for HMAC identifier lookup hashes (preserves privacy of NISN/NIP)
IDENTIFIER_LOOKUP_PEPPER=talentra-identifier-lookup-pepper-v1
CV_VERIFICATION_TOKEN_PEPPER=talentra-cv-token-pepper-v1

# -------------------------------------------------------------
# DATABASE (NEON POSTGRESQL / LOCAL SQLITE)
# -------------------------------------------------------------
# In local dev: can use SQLite (sqlite+aiosqlite:///./test_talentra.db)
# or local PostgreSQL / Neon development database
DATABASE_URL=sqlite+aiosqlite:///./test_talentra.db
REPOSITORY_BACKEND=postgres

# -------------------------------------------------------------
# OBJECT STORAGE (LOCAL / VERCEL BLOB / S3)
# -------------------------------------------------------------
# Options: local (development) | vercel_blob (production) | s3 (optional)
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=backend/storage_data
PRESIGNED_URL_TTL=900

# -------------------------------------------------------------
# FREE-TIER STORAGE PROTECTION
# -------------------------------------------------------------
FREE_TIER_MODE=true
STORAGE_SOFT_LIMIT_BYTES=209715200

# -------------------------------------------------------------
# DEMO ACCESS (DEVELOPMENT ONLY)
# -------------------------------------------------------------
ENABLE_DEMO_AUTH=true
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true

# -------------------------------------------------------------
# CORS
# -------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
